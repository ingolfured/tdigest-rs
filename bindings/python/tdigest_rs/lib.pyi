from typing import Any, Literal, overload

import numpy as np
from numpy.typing import NDArray

from ._modern import TDigest as _CapacityDigest, Values
from ._shared import DEFAULT_DELTA as DEFAULT_DELTA

class TDigest:
    @overload
    @classmethod
    def from_array(cls, arr: Values = ..., *, max_size: int, **options: Any) -> _CapacityDigest: ...
    @overload
    @classmethod
    def from_array(cls, arr: NDArray[Any], delta: float = ...) -> TDigest: ...
    @overload
    @classmethod
    def from_means_weights(cls, arr: Values, weights: Values, *, max_size: int, **options: Any) -> _CapacityDigest: ...
    @overload
    @classmethod
    def from_means_weights(cls, arr: NDArray[Any], weights: NDArray[np.uint32], delta: float = ...) -> TDigest: ...
    @classmethod
    def from_dict(cls, d: dict[str, Any]) -> TDigest | _CapacityDigest: ...
    @staticmethod
    def from_bytes(b: bytes) -> _CapacityDigest: ...
    merge_all = _CapacityDigest.merge_all
    @property
    def means(self) -> NDArray[np.float32 | np.float64]: ...
    @property
    def weights(self) -> NDArray[np.uint32]: ...
    def __len__(self) -> int: ...
    def quantile(self, q: float) -> float: ...
    def median(self) -> float: ...
    def trimmed_mean(self, lower: float, upper: float) -> float: ...
    def merge(self, other: TDigest, delta: float = ...) -> TDigest: ...
    def update(self, buffer: NDArray[Any], delta: float = ..., merge_delta: float = ...) -> TDigest: ...
    def cast_precision(self, precision: Literal["f32", "f64"]) -> TDigest: ...
    def to_dict(self) -> dict[str, Any]: ...
